---
export interface Props {
  title: string;
}

const { title } = Astro.props;

import "@fontsource/poppins/100.css";
import "@fontsource/poppins/200.css";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";

import Header from "../components/Header.astro";
---

<style is:global>
  @import "../styles/global.css";

  body {
    font-family: "Poppins", sans-serif;
  }

  /* Prevenir scroll horizontal sin interferir con los estilos */
  html {
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  /* Skip link para accesibilidad */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: #2d2d2d;
    color: white;
    padding: 8px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    z-index: 1000;
    transition: top 0.3s;
  }

  .skip-link:focus {
    top: 6px;
  }

  /* Compensar la altura del header fijo */
  main {
    padding-top: 100px;
  }

  /* Asegurar que todas las secciones tengan scroll-margin adecuado */
  section[id],
  *[id] {
    scroll-margin-top: 140px !important;
  }
</style>

<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Clínica de Kinesiología KinesioVital - Rehabilitación y terapia física especializada en Chile. Tratamientos personalizados para deportistas y rehabilitación post-quirúrgica."
    />
    <meta
      name="keywords"
      content="kinesiología, rehabilitación, terapia física, fisioterapia, Chile, deportistas, lesiones, recuperación"
    />
    <meta
      name="author"
      content="KinesioVital"
    />
    <meta
      name="robots"
      content="index, follow"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="canonical"
      href="https://alegonzalezcelis.github.io/Clinical-Web/"
    />

    <!-- Open Graph / Facebook -->
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:url"
      content="https://alegonzalezcelis.github.io/Clinical-Web/"
    />
    <meta
      property="og:title"
      content="KinesioVital - Clínica de Kinesiología y Rehabilitación"
    />
    <meta
      property="og:description"
      content="Centro especializado en rehabilitación y terapia física. Tratamientos personalizados para tu recuperación."
    />

    <!-- Twitter -->
    <meta
      property="twitter:card"
      content="summary_large_image"
    />
    <meta
      property="twitter:url"
      content="https://alegonzalezcelis.github.io/Clinical-Web/"
    />
    <meta
      property="twitter:title"
      content="KinesioVital - Clínica de Kinesiología y Rehabilitación"
    />
    <meta
      property="twitter:description"
      content="Centro especializado en rehabilitación y terapia física. Tratamientos personalizados para tu recuperación."
    />

    <title>{title}</title>
  </head>
  <body class="text-ColorText">
    <!-- Skip link para accesibilidad -->
    <a
      href="#main-content"
      class="skip-link"
      >Ir al contenido principal</a
    >
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <script>
      // Sistema de animaciones elegantes estilo ReactBits.dev
      const createModernScrollReveal = () => {
        // Configuración de animaciones más sofisticada
        const animationConfig = {
          "scroll-fade-up": {
            animation: "modern-fade-up",
            delay: 0,
            duration: "1.2s",
          },
          "scroll-fade-left": {
            animation: "modern-slide-left",
            delay: 100,
            duration: "1s",
          },
          "scroll-fade-right": {
            animation: "modern-slide-right",
            delay: 100,
            duration: "1s",
          },
          "scroll-scale": {
            animation: "modern-scale",
            delay: 200,
            duration: "0.8s",
          },
          "scroll-slide-up": {
            animation: "modern-slide-up",
            delay: 0,
            duration: "1.4s",
          },
          "animate-on-scroll": {
            animation: "modern-fade-up",
            delay: 0,
            duration: "1.2s",
          },
          "scroll-reveal": {
            animation: "modern-fade-up",
            delay: 0,
            duration: "1.2s",
          },
        };

        // Observer con configuración más precisa
        const observerOptions = {
          threshold: 0.15,
          rootMargin: "0px 0px -100px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const element = entry.target;

              // Encontrar configuración de animación
              let config = null;
              for (const [className, animConfig] of Object.entries(
                animationConfig,
              )) {
                if (element.classList.contains(className)) {
                  config = animConfig;
                  break;
                }
              }

              if (config) {
                // Aplicar animación con timing moderno
                setTimeout(() => {
                  element.style.animationDuration = config.duration;
                  element.classList.add(
                    `animate-${config.animation.replace("modern-", "")}`,
                  );
                  element.classList.add("is-visible");
                }, config.delay);
              }

              observer.unobserve(element);
            }
          });
        }, observerOptions);

        // Función para configurar elementos con delays escalonados más sutiles
        const setupAnimatedElements = () => {
          // Elementos principales
          document
            .querySelectorAll('[class*="scroll-"]')
            .forEach((el, index) => {
              observer.observe(el);
            });

          // Cards con delays escalonados más elegantes
          document.querySelectorAll(".service-card").forEach((el, index) => {
            el.style.transitionDelay = `${index * 120}ms`;
            observer.observe(el);
          });

          // Items de beneficios con timing perfecto
          document.querySelectorAll(".benefit-item").forEach((el, index) => {
            el.style.transitionDelay = `${index * 80}ms`;
            observer.observe(el);
          });
        };

        // Inicializar
        setupAnimatedElements();
        setupCounterAnimations();
        console.log("🎨 Modern Scroll Reveal Active");
      };

      // Sistema de conteo animado estilo ReactBits.dev
      const setupCounterAnimations = () => {
        const counterElements = document.querySelectorAll(".counter-number");

        const animateCounter = (
          element,
          finalValue,
          duration = 2000,
          prefix = "",
          suffix = "",
        ) => {
          const startValue = 0;
          const startTime = performance.now();

          // Configurar el elemento
          element.classList.add("counting");

          const updateCounter = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);

            // Función de easing suave para el conteo
            const easedProgress = 1 - Math.pow(1 - progress, 3);
            const currentValue = Math.floor(
              startValue + (finalValue - startValue) * easedProgress,
            );

            // Formatear el número
            let displayValue = currentValue.toLocaleString();
            element.textContent = prefix + displayValue + suffix;

            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              // Animación completada
              element.textContent =
                prefix + finalValue.toLocaleString() + suffix;
              element.classList.remove("counting");
            }
          };

          requestAnimationFrame(updateCounter);
        };

        // Observer para las estadísticas
        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const element = entry.target;
                const text = element.textContent || element.innerText;

                // Extraer información del número
                let finalValue,
                  prefix = "",
                  suffix = "";

                if (text.includes("30.000") || text.includes("30000")) {
                  finalValue = 30000;
                  prefix = "+";
                } else if (text.includes("500")) {
                  finalValue = 500;
                  prefix = "+";
                } else if (text.includes("10")) {
                  finalValue = 10;
                  prefix = "+";
                }

                if (finalValue) {
                  // Delay escalonado para las estadísticas
                  const delay =
                    Array.from(counterElements).indexOf(element) * 200;
                  setTimeout(() => {
                    animateCounter(element, finalValue, 1800, prefix, suffix);
                  }, delay);
                }

                counterObserver.unobserve(element);
              }
            });
          },
          {
            threshold: 0.5,
            rootMargin: "0px 0px -100px 0px",
          },
        );

        // Observar todos los elementos counter
        counterElements.forEach((el) => {
          counterObserver.observe(el);
        });
      };

      // Inicialización mejorada
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", createModernScrollReveal);
      } else {
        createModernScrollReveal();
      }
    </script>
  </body>
</html>

<style>
  .font-inter {
    font-family: "Inter", sans-serif;
  }

  /* Estados iniciales - Estilo ReactBits más sutil */
  .animate-on-scroll,
  .scroll-reveal,
  .scroll-fade-up,
  .scroll-fade-left,
  .scroll-fade-right,
  .scroll-scale,
  .scroll-slide-up,
  .service-card,
  .benefit-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .scroll-fade-left {
    opacity: 0;
    transform: translateX(-30px);
  }

  .scroll-fade-right {
    opacity: 0;
    transform: translateX(30px);
  }

  .scroll-scale {
    opacity: 0;
    transform: scale(0.95) translateY(10px);
  }

  .scroll-slide-up {
    opacity: 0;
    transform: translateY(40px);
  }

  /* Animaciones modernas estilo ReactBits */
  @keyframes modern-fade-up {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes modern-slide-left {
    0% {
      opacity: 0;
      transform: translateX(-30px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes modern-slide-right {
    0% {
      opacity: 0;
      transform: translateX(30px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes modern-scale {
    0% {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes modern-slide-up {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Animaciones legacy actualizadas */
  @keyframes fade-up {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-left {
    0% {
      opacity: 0;
      transform: translateX(-30px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fade-right {
    0% {
      opacity: 0;
      transform: translateX(30px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes scale-in {
    0% {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes slide-up {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Estado visible - Transición elegante */
  .is-visible,
  .animate-fade-up,
  .animate-fade-left,
  .animate-fade-right,
  .animate-scale,
  .animate-slide-up {
    opacity: 1;
    transform: translateY(0) translateX(0) scale(1);
    transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Clases de animación específicas */
  .animate-fade-up {
    animation: modern-fade-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-fade-left {
    animation: modern-slide-left 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-fade-right {
    animation: modern-slide-right 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-scale {
    animation: modern-scale 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-slide-up {
    animation: modern-slide-up 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Legacy support */
  .animate-fade-in-up {
    animation: modern-fade-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Efectos hover elegantes estilo ReactBits */
  .service-card {
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center bottom;
  }

  .service-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .benefit-item {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .benefit-item:hover {
    transform: translateX(8px);
    opacity: 0.9;
  }

  /* Efectos adicionales para botones */
  .scroll-scale:hover {
    transform: scale(1.05);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Accesibilidad y responsive optimizado */
  @media (prefers-reduced-motion: reduce) {
    /* Respeto total a las preferencias de accesibilidad */
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .animate-on-scroll,
    .scroll-reveal,
    .scroll-fade-up,
    .scroll-fade-left,
    .scroll-fade-right,
    .scroll-scale,
    .scroll-slide-up,
    .service-card,
    .benefit-item {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Optimización móvil - Animaciones más rápidas */
  @media (max-width: 768px) {
    .animate-fade-up,
    .animate-fade-left,
    .animate-fade-right,
    .animate-scale,
    .animate-slide-up {
      animation-duration: 0.8s;
      transition-duration: 0.8s;
    }

    .service-card:hover {
      transform: translateY(-4px) scale(1.01);
    }
  }

  /* Performance para pantallas de alta resolución */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    .animate-fade-up,
    .animate-fade-left,
    .animate-fade-right,
    .animate-scale,
    .animate-slide-up,
    .service-card,
    .benefit-item {
      will-change: transform, opacity;
      backface-visibility: hidden;
      perspective: 1000px;
    }
  }

  /* Mejoras para pantallas grandes */
  @media (min-width: 1200px) {
    .service-card:hover {
      transform: translateY(-12px) scale(1.03);
    }
  }

  /* Animación de conteo para estadísticas - Estilo ReactBits */
  .counter-number {
    display: inline-block;
    font-variant-numeric: tabular-nums;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .counter-number.counting {
    color: #4ecdc4;
    text-shadow: 0 0 10px rgba(78, 205, 196, 0.3);
  }

  /* Efecto de pulsación sutil durante el conteo */
  @keyframes counter-pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1);
    }
  }

  .counter-number.counting {
    animation: counter-pulse 0.6s ease-in-out;
  }x
</style>
