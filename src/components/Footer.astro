            <div class="lg:col-span-1 scroll-fade-up">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-white mb-2">
                        KinesioVital
                    </h3>
                    <div class="w-12 h-1 bg-ColorAqua rounded-full"></div>
                </div>
                <p class="text-gray-300 leading-relaxed mb-6">
                    Centro especializado en kinesiología y rehabilitación
                    física. Comprometidos con tu recuperación y bienestar
                    integral.
                </p>

                <!-- Redes sociales -->
                <div class="flex space-x-4">
