---

---

<header class="bg-white shadow-sm fixed top-0 left-0 right-0 z-50 h-25 flex">
  <div class="container mx-auto my-auto px-4 sm:px-6 md:px-10 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center space-x-2">
        <div
          class="w-8 h-8 bg-ColorAqua rounded-lg flex items-center justify-center"
        >
          <span class="text-white font-bold text-lg">K</span>
        </div>
        <span class="text-xl font-bold text-ColorTitle">KinesioVital</span>
      </div>

      <!-- Menú de navegación Desktop -->
      <div class="hidden md:flex space-x-6 text-sm">
        <a
          href="#inicio"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >Inicio</a
        >
        <a
          href="#servicios"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >Servicios</a
        >
        <a
          href="#nosotros"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >Nosotros</a
        >
        <a
          href="#equipo"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >Equipo</a
        >
        <a
          href="#testimonios"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >Testimonios</a
        >
        <a
          href="#faq"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >FAQ</a
        >
        <a
          href="#contacto"
          class="nav-link text-gray-800 transition-all duration-300 relative"
          >Contacto</a
        >
      </div>

      <!-- Botón CTA Desktop -->
      <div class="hidden md:block">
        <a
          href="https://agendapro.com/mp/cl/entrenamiento-melipilla"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-ColorAqua text-white px-6 py-2 rounded-full hover:bg-ColorAquaHover transition-colors"
          aria-label="Reservar cita médica en línea (se abre en nueva pestaña)"
        >
          Reservar Cita
        </a>
      </div>

      <!-- Botón menú móvil -->
      <button
        id="menuButton"
        class="md:hidden p-2 relative w-8 h-8 flex items-center justify-center"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobileMenu"
        type="button"
      >
        <div class="hamburger-icon">
          <span class="hamburger-line top"></span>
          <span class="hamburger-line middle"></span>
          <span class="hamburger-line bottom"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div
    id="mobileMenu"
    class="md:hidden mobile-menu"
    role="navigation"
    aria-label="Menú de navegación móvil"
  >
    <div class="container mx-auto px-4 sm:px-6 md:px-10 py-6">
      <div class="flex flex-col space-y-2">
        <a
          href="#inicio"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >Inicio</a
        >
        <a
          href="#servicios"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >Servicios</a
        >
        <a
          href="#nosotros"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >Nosotros</a
        >
        <a
          href="#equipo"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >Equipo</a
        >
        <a
          href="#testimonios"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >Testimonios</a
        >
        <a
          href="#faq"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >FAQ</a
        >
        <a
          href="#contacto"
          class="mobile-nav-link text-gray-800 py-3 px-4 rounded-lg transition-colors"
          >Contacto</a
        >
        <a
          href="https://agendapro.com/mp/cl/entrenamiento-melipilla"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-ColorAqua text-white px-6 py-3 rounded-full hover:bg-ColorAquaHover transition-colors text-center mt-4"
        >
          Agendar Cita
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* SOLUCIÓN AL PROBLEMA DEL HEADER */
  section[id] {
    scroll-margin-top: 140px;
  }

  /* Alternativa más robusta para todos los elementos con ID */
  *[id] {
    scroll-margin-top: 140px;
  }

  /* Estilos del menú móvil */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border-top: 1px solid #e5e7eb;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  /* Estilos para enlaces desktop - estilo nanamia.cl */
  .nav-link {
    position: relative;
    padding: 8px 4px;
    overflow: hidden;
  }

  .nav-link::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(78, 205, 196, 0.2),
      transparent
    );
    transition: left 0.5s ease;
  }

  .nav-link:hover::before {
    left: 100%;
  }

  .nav-link:hover {
    color: #4ecdc4;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #4ecdc4;
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Estado activo - solo subrayado */
  .nav-link.active {
    color: #4ecdc4;
  }

  .nav-link.active::after {
    width: 100%;
  }

  /* Estilos para enlaces móviles - solo estado activo */
  .mobile-nav-link {
    position: relative;
  }

  .mobile-nav-link.active {
    color: #4ecdc4;
  }

  .mobile-nav-link.active::after {
    content: "";
    position: absolute;
    bottom: 8px;
    left: 16px;
    right: 16px;
    height: 2px;
    background-color: #4ecdc4;
  }

  /* Estilos del icono hamburguesa */
  .hamburger-icon {
    width: 24px;
    height: 18px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    display: block;
    height: 2px;
    width: 100%;
    background-color: #374151;
    border-radius: 1px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  /* Animación a X */
  .hamburger-icon.active .hamburger-line.top {
    transform: translateY(8px) rotate(45deg);
  }

  .hamburger-icon.active .hamburger-line.middle {
    opacity: 0;
    transform: scaleX(0);
  }

  .hamburger-icon.active .hamburger-line.bottom {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const menuButton = document.querySelector("#menuButton");
  const mobileMenu = document.querySelector("#mobileMenu");
  const hamburgerIcon = document.querySelector(".hamburger-icon");
  const navLinks = document.querySelectorAll(".nav-link, .mobile-nav-link");

  menuButton?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.contains("open");

    if (isOpen) {
      // Cerrar menú
      mobileMenu?.classList.remove("open");
      hamburgerIcon?.classList.remove("active");
      menuButton?.setAttribute("aria-expanded", "false");
      menuButton?.setAttribute("aria-label", "Abrir menú de navegación");
    } else {
      // Abrir menú
      mobileMenu?.classList.add("open");
      hamburgerIcon?.classList.add("active");
      menuButton?.setAttribute("aria-expanded", "true");
      menuButton?.setAttribute("aria-label", "Cerrar menú de navegación");
    }
  });

  // Cerrar menú al hacer click en un enlace
  const mobileMenuLinks = mobileMenu?.querySelectorAll("a");
  mobileMenuLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.remove("open");
      hamburgerIcon?.classList.remove("active");
      menuButton?.setAttribute("aria-expanded", "false");
      menuButton?.setAttribute("aria-label", "Abrir menú de navegación");
    });
  });

  // Cerrar menú al hacer click fuera de él
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (!menuButton?.contains(target) && !mobileMenu?.contains(target)) {
      mobileMenu?.classList.remove("open");
      hamburgerIcon?.classList.remove("active");
      menuButton?.setAttribute("aria-expanded", "false");
      menuButton?.setAttribute("aria-label", "Abrir menú de navegación");
    }
  });

  // Función para marcar enlace activo basado en scroll
  function setActiveLink() {
    const sections = document.querySelectorAll("section[id]");
    const scrollPosition = window.scrollY + 140;

    sections.forEach((section) => {
      // Verificar que sea un HTMLElement para acceder a offsetTop y offsetHeight
      if (!(section instanceof HTMLElement)) return;

      const sectionTop = section.offsetTop;
      const sectionHeight = section.offsetHeight;
      const sectionId = section.getAttribute("id");

      if (
        scrollPosition >= sectionTop &&
        scrollPosition < sectionTop + sectionHeight
      ) {
        // Remover clase active de todos los enlaces
        navLinks.forEach((link) => link.classList.remove("active"));

        // Agregar clase active al enlace correspondiente
        const activeLinks = document.querySelectorAll(`[href="#${sectionId}"]`);
        activeLinks.forEach((link) => {
          if (
            link.classList.contains("nav-link") ||
            link.classList.contains("mobile-nav-link")
          ) {
            link.classList.add("active");
          }
        });
      }
    });
  }

  // Ejecutar al cargar y al hacer scroll
  window.addEventListener("scroll", setActiveLink);
  window.addEventListener("load", setActiveLink);
</script>
