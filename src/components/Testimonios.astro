---
// Sección de testimonios inspirada en el diseño de Behance
// Enfocada en generar confianza y mostrar resultados reales
---

<section
    id="testimonios"
    class="py-16 mb-16"
>
    <div class="container mx-auto px-4 sm:px-6 md:px-10">
        <!-- Header de la sección -->
        <div class="text-center mb-12 scroll-fade-up">
            <span class="text-ColorAqua text-lg font-medium scroll-fade-up">
                Testimonios
            </span>
            <h2 class="text-3xl font-bold text-ColorTitle mt-2 scroll-fade-up">
                Historias Reales de Recuperación y Bienestar
            </h2>
            <p class="text-gray-600 mt-4 max-w-2xl mx-auto scroll-fade-up">
                Descubre cómo nuestros pacientes han recuperado su movilidad y
                mejorado su calidad de vida con nuestros tratamientos
                personalizados.
            </p>
        </div>

        <!-- Grid de testimonios -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Testimonio 1 -->
            <div
                class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 service-card"
            >
                <div class="flex items-center mb-4">
                    <!-- Avatar -->
                    <div
                        class="w-12 h-12 bg-gradient-to-br from-ColorAqua to-blue-500 rounded-full flex items-center justify-center text-white font-semibold text-lg"
                    >
                        M
                    </div>
                    <div class="ml-4">
                        <h4 class="font-semibold text-ColorTitle">
                            María González
                        </h4>
                        <p class="text-sm text-gray-500">Paciente desde 2023</p>
                    </div>
                </div>
                <!-- Estrellas -->
                <div class="flex mb-4">
                    <svg
                        class="w-5 h-5 text-yellow-400 fill-current"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"
                        ></path>
                    </svg>
                    <svg
                        class="w-5 h-5 text-yellow-400 fill-current"
