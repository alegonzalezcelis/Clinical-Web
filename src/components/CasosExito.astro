---
// Galería de casos de éxito inspirada en el diseño de Behance
// Muestra resultados tangibles para generar confianza
---

<section
    id="casos-exito"
    class="py-16 mb-16"
>
    <div class="container mx-auto px-4 sm:px-6 md:px-10">
        <!-- Header de la sección -->
        <div class="text-center mb-12 scroll-fade-up">
            <span class="text-ColorAqua text-lg font-medium scroll-fade-up">
                Casos de Éxito
            </span>
            <h2 class="text-3xl font-bold text-ColorTitle mt-2 scroll-fade-up">
                Resultados Reales que Transforman Vidas
            </h2>
            <p class="text-gray-600 mt-4 max-w-2xl mx-auto scroll-fade-up">
                Descubre cómo nuestros tratamientos personalizados han ayudado a
                pacientes reales a recuperar su movilidad y mejorar su calidad
                de vida.
            </p>
        </div>

        <!-- Grid de casos -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            <!-- Caso 1: Rehabilitación de rodilla -->
            <div
                class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 service-card"
            >
                <div class="p-6">
                    <div class="flex items-center mb-4">
                        <div class="w-3 h-3 bg-ColorAqua rounded-full mr-3">
                        </div>
                        <span class="text-ColorAqua font-medium"
                            >Rehabilitación Deportiva</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-ColorTitle mb-4">
                        Recuperación Total de Lesión de Rodilla
                    </h3>

                    <!-- Progreso visual -->
                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div class="text-center">
                            <div class="bg-red-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-red-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M6 18L18 6M6 6l12 12"
                                        ></path>
                                    </svg>
                                </div>
                                <h4 class="font-semibold text-red-600 text-sm">
                                    ANTES
                                </h4>
                                <p class="text-red-500 text-xs mt-1">
                                    Dolor severo<br />Movilidad limitada
                                </p>
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="bg-green-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-green-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        ></path>
                                    </svg>
                                </div>
                                <h4
                                    class="font-semibold text-green-600 text-sm"
                                >
                                    DESPUÉS
                                </h4>
                                <p class="text-green-500 text-xs mt-1">
                                    Sin dolor<br />Movilidad completa
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Métricas de progreso -->
                    <div class="space-y-3 mb-6">
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600"
                                    >Reducción del dolor</span
                                >
                                <span class="text-ColorAqua font-medium"
                                    >95%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-ColorAqua h-2 rounded-full"
                                    style="width: 95%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600"
                                    >Rango de movimiento</span
                                >
                                <span class="text-ColorAqua font-medium"
                                    >90%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-ColorAqua h-2 rounded-full"
                                    style="width: 90%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600"
                                    >Fuerza muscular</span
                                >
                                <span class="text-ColorAqua font-medium"
                                    >85%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-ColorAqua h-2 rounded-full"
                                    style="width: 85%"
                                >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del caso -->
                    <div class="border-t pt-4">
                        <div class="flex justify-between text-sm text-gray-600">
                            <span><strong>Duración:</strong> 8 semanas</span>
                            <span><strong>Sesiones:</strong> 24</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-2">
                            <strong>Paciente:</strong> Deportista amateur, 28 años
                        </p>
                    </div>
                </div>
            </div>

            <!-- Caso 2: Rehabilitación de espalda -->
            <div
                class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 service-card"
            >
                <div class="p-6">
                    <div class="flex items-center mb-4">
                        <div class="w-3 h-3 bg-green-500 rounded-full mr-3">
                        </div>
                        <span class="text-green-500 font-medium"
                            >Rehabilitación Postural</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-ColorTitle mb-4">
                        Eliminación de Dolor Lumbar Crónico
                    </h3>

                    <!-- Progreso visual -->
                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div class="text-center">
                            <div class="bg-red-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-red-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                        ></path>
                                    </svg>
                                </div>
                                <h4 class="font-semibold text-red-600 text-sm">
                                    ANTES
                                </h4>
                                <p class="text-red-500 text-xs mt-1">
                                    Dolor constante<br />Postura incorrecta
                                </p>
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="bg-green-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-green-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <h4
                                    class="font-semibold text-green-600 text-sm"
                                >
                                    DESPUÉS
                                </h4>
                                <p class="text-green-500 text-xs mt-1">
                                    Sin molestias<br />Postura corregida
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Métricas de progreso -->
                    <div class="space-y-3 mb-6">
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600"
                                    >Reducción del dolor</span
                                >
                                <span class="text-green-500 font-medium"
                                    >100%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-green-500 h-2 rounded-full"
                                    style="width: 100%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600"
                                    >Corrección postural</span
                                >
                                <span class="text-green-500 font-medium"
                                    >88%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-green-500 h-2 rounded-full"
                                    style="width: 88%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Flexibilidad</span>
                                <span class="text-green-500 font-medium"
                                    >92%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-green-500 h-2 rounded-full"
                                    style="width: 92%"
                                >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del caso -->
                    <div class="border-t pt-4">
                        <div class="flex justify-between text-sm text-gray-600">
                            <span><strong>Duración:</strong> 12 semanas</span>
                            <span><strong>Sesiones:</strong> 36</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-2">
                            <strong>Paciente:</strong> Profesional de oficina, 42
                            años
                        </p>
                    </div>
                </div>
            </div>

            <!-- Caso 3: Rehabilitación neurológica -->
            <div
                class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 service-card"
            >
                <div class="p-6">
                    <div class="flex items-center mb-4">
                        <div class="w-3 h-3 bg-purple-500 rounded-full mr-3">
                        </div>
                        <span class="text-purple-500 font-medium"
                            >Rehabilitación Neurológica</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-ColorTitle mb-4">
                        Recuperación Motora Post-ACV
                    </h3>

                    <!-- Progreso visual -->
                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div class="text-center">
                            <div class="bg-red-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-red-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728"
                                        ></path>
                                    </svg>
                                </div>
                                <h4 class="font-semibold text-red-600 text-sm">
                                    ANTES
                                </h4>
                                <p class="text-red-500 text-xs mt-1">
                                    Pérdida motora<br />Dependencia total
                                </p>
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="bg-green-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-green-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <h4
                                    class="font-semibold text-green-600 text-sm"
                                >
                                    DESPUÉS
                                </h4>
                                <p class="text-green-500 text-xs mt-1">
                                    Motricidad recuperada<br />Independencia
                                    funcional
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Métricas de progreso -->
                    <div class="space-y-3 mb-6">
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Función motora</span
                                >
                                <span class="text-purple-500 font-medium"
                                    >75%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-purple-500 h-2 rounded-full"
                                    style="width: 75%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Equilibrio</span>
                                <span class="text-purple-500 font-medium"
                                    >80%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-purple-500 h-2 rounded-full"
                                    style="width: 80%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Independencia</span>
                                <span class="text-purple-500 font-medium"
                                    >70%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-purple-500 h-2 rounded-full"
                                    style="width: 70%"
                                >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del caso -->
                    <div class="border-t pt-4">
                        <div class="flex justify-between text-sm text-gray-600">
                            <span><strong>Duración:</strong> 6 meses</span>
                            <span><strong>Sesiones:</strong> 72</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-2">
                            <strong>Paciente:</strong> Adulto mayor, 65 años
                        </p>
                    </div>
                </div>
            </div>

            <!-- Caso 4: Rehabilitación pediátrica -->
            <div
                class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 service-card"
            >
                <div class="p-6">
                    <div class="flex items-center mb-4">
                        <div class="w-3 h-3 bg-blue-500 rounded-full mr-3">
                        </div>
                        <span class="text-blue-500 font-medium"
                            >Rehabilitación Pediátrica</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-ColorTitle mb-4">
                        Desarrollo Motor en Niño con Retraso
                    </h3>

                    <!-- Progreso visual -->
                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div class="text-center">
                            <div class="bg-red-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-red-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <h4 class="font-semibold text-red-600 text-sm">
                                    ANTES
                                </h4>
                                <p class="text-red-500 text-xs mt-1">
                                    Retraso motor<br />Dificultades de
                                    equilibrio
                                </p>
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="bg-green-50 rounded-xl p-4 mb-3">
                                <div
                                    class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2"
                                >
                                    <svg
                                        class="w-8 h-8 text-green-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-worth="2"
                                            d="M14.828 14.828a4 4 0 01-5.656 0M9.172 9.172a4 4 0 015.656 0M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <h4
                                    class="font-semibold text-green-600 text-sm"
                                >
                                    DESPUÉS
                                </h4>
                                <p class="text-green-500 text-xs mt-1">
                                    Desarrollo normalizado<br />Actividades de
                                    su edad
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Métricas de progreso -->
                    <div class="space-y-3 mb-6">
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600"
                                    >Desarrollo motor grueso</span
                                >
                                <span class="text-blue-500 font-medium"
                                    >85%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-blue-500 h-2 rounded-full"
                                    style="width: 85%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Coordinación</span>
                                <span class="text-blue-500 font-medium"
                                    >78%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-blue-500 h-2 rounded-full"
                                    style="width: 78%"
                                >
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-600">Equilibrio</span>
                                <span class="text-blue-500 font-medium"
                                    >82%</span
                                >
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div
                                    class="bg-blue-500 h-2 rounded-full"
                                    style="width: 82%"
                                >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del caso -->
                    <div class="border-t pt-4">
                        <div class="flex justify-between text-sm text-gray-600">
                            <span><strong>Duración:</strong> 5 meses</span>
                            <span><strong>Sesiones:</strong> 40</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-2">
                            <strong>Paciente:</strong> Niño, 6 años
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estadísticas generales -->
        <div
            class="bg-ColorBackground rounded-2xl p-8 text-center scroll-fade-up"
        >
            <h3 class="text-2xl font-bold text-ColorTitle mb-6">
                Resultados que Hablan por Sí Solos
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="scroll-scale">
                    <h4
                        class="text-3xl font-bold text-ColorAqua counter-number"
                    >
                        96
                    </h4>
                    <p class="text-gray-600 font-medium">% Tasa de éxito</p>
                </div>
                <div class="scroll-scale">
                    <h4
                        class="text-3xl font-bold text-ColorAqua counter-number"
                    >
                        87
                    </h4>
                    <p class="text-gray-600 font-medium">
                        % Reducción promedio de dolor
                    </p>
                </div>
                <div class="scroll-scale">
                    <h4
                        class="text-3xl font-bold text-ColorAqua counter-number"
                    >
                        12
                    </h4>
                    <p class="text-gray-600 font-medium">
                        Semanas promedio de tratamiento
                    </p>
                </div>
                <div class="scroll-scale">
                    <h4
                        class="text-3xl font-bold text-ColorAqua counter-number"
                    >
                        98
                    </h4>
                    <p class="text-gray-600 font-medium">
                        % Pacientes satisfechos
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
